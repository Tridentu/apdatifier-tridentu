#!/usr/bin/env bash

source "$(dirname "$0")/utils"

[ "$1" ] && selected="$1" || selected=0

    wrapper="${wrapper##*/}"
    wrapper_sudo=$wrapper

if [[ $termFont = "true" ]]; then
    ICO_MNG_01="󱝩"
    ICO_MNG_02="󱝕"
    ICO_MNG_03="󱝭"
    ICO_MNG_04="󱝧"
    ICO_MNG_05="󱝥"
    ICO_MNG_06="󱝝"
    ICO_MNG_07=""
    ICO_MNG_08="󱘴"
    ICO_MNG_09="󰌠"
    ICO_MNG_10="󱝏"
    ICO_MNG_11="󰏖"
    ICO_MNG_12="󱧕"
    ICO_MNG_13="󱝑"
fi

fzf_settings="--preview-window=right:70%,border-none \
              --height=100% \
              --margin=0 \
              --padding=0 \
              --layout=reverse \
              --style minimal \
              --scrollbar \
              --color dark \
              --multi \
              --track \
              --exact \
              --cycle \
              --no-separator \
              --info=right \
              --marker=•"

[[ -n "$fzfOptions" ]] && fzf_settings+=" $fzfOptions"

show_help=false

showMenu() {
    menu_type=$1
    opts=()

    case $menu_type in
        main)
            opts+=("$ICO_MNG_01 $MNG_BROWSE")
            opts+=("$ICO_MNG_02 $MNG_INST")
            opts+=("$ICO_MNG_03 $MNG_EXPL")
            opts+=("$ICO_MNG_04 $MNG_ORPH")
            opts+=("$ICO_MNG_05 $MNG_DOWNGR")
            opts+=("$ICO_MNG_06 $MNG_CACHE")
            opts+=("$ICO_MNG_10 $MNG_RECENT")
            redraw
            case $selected in
                0) [[ $mngHideFlatpak = true ]] && fzfExec Slq || showMenu browse;;
                1) [[ $mngHideFlatpak = true ]] && fzfExec Qq || showMenu installed;;
                2) showMenu explicit;;
                3) showMenu orphans;;
                4) downgrade;;
                5) showMenu cache;;
                6) recentlyInstalled;;
            esac
            ;;
        browse)
            selected=0
            opts+=("$ICO_MNG_11 apt")
            opts+=("$ICO_MNG_11 flathub")
            redraw
            case $selected in
                0) fzfExec Slq;;
                1) flatpakFlathub;;
                2) selected=0; showMenu main;;
            esac
            ;;
        installed)
            selected=0
            opts+=("$ICO_MNG_11 apt")
            opts+=("$ICO_MNG_11 flatpak")
            redraw
            case $selected in
                0) fzfExec Qq;;
                1) flatpakInstalled;;
                2) selected=1; showMenu main;;
            esac
            ;;
        explicit)
            selected=0
            opts+=("$ICO_MNG_03 $MNG_EXPL_L")
            opts+=("$ICO_MNG_04 $MNG_EXPL_U")
            redraw
            case $selected in
                0) fzfExec Qqe;;
                1) fzfExec Qqet;;
                2) selected=2; showMenu main;;
            esac
            ;;
        orphans)
            selected=0
            opts+=("$ICO_MNG_06 $MNG_ORPH_L")
            opts+=("$ICO_MNG_07 $MNG_ORPH_R")
            redraw
            case $selected in
                0) fzfExec Qqtd;;
                1) uninstallOrphans;;
                2) selected=3; showMenu main;;
            esac
            ;;
        cache)
            selected=0
            opts+=("$ICO_MNG_07 $MNG_CACHE_A")
            opts+=("$ICO_MNG_06 $MNG_CACHE_U")
            redraw
            case $selected in
                0) cleanCache Scc;;
                1) cleanCache Sc;;
                2) selected=5; showMenu main;;
            esac
            ;;
    esac
}

draw_menu() {
    printf '\e[H'

    local min_height=$((${#opts[@]} + 4))
    if ((LINES < min_height)); then
        printf '\e[2J'
        echo "Terminal too small (need ${min_height} lines)"
        return
    fi


    if [[ $mngHideHeaders == false ]]; then
        local header
        case $menu_type in
                main) header="$ICO_MNG_13 $MNG_HEADER";;
              browse) header="$ICO_MNG_12 $MNG_BROWSE_H";;
           installed) header="$ICO_MNG_11 $MNG_INST_H";;
            explicit) header="$ICO_MNG_03 $MNG_EXPL_H";;
             orphans) header="$ICO_MNG_04 $MNG_ORPH_H";;
               cache) header="$ICO_MNG_06 $MNG_CACHE_H";;
        esac

        echo -e "$(colorize gray bold $header)\n"
    fi


    for i in "${!opts[@]}"; do

        local number=$((i + 1))
        if [[ $mngHideNums == false ]]; then
            number="$(colorize gray $number.) "
        else
            number=""
        fi

        if [[ $i -eq $selected ]]; then
            echo "$number$(colorize green bold ${opts[$i]})"
        else
            echo "$number${opts[$i]# }"
        fi
    done

    if [[ $mngHideHelp == false ]]; then
        tput cup $((LINES - 2)) 0

        local footer
        if [[ $show_help == true ]]; then
            footer='→ l Enter 1-9 · select   ↑ k · up   ↓ j · down   ← h · back   q · quit'
        else
            footer='? · help'
        fi
        printf "$(colorize gray '%s')%*s\n" "$footer" "$((COLUMNS - ${#footer}))" ""
    fi
}




aptList() {
    case $1 in
        Slq)  apt-cache pkgnames ;;
        Qq)   dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>/dev/null \
                  | awk '$1 == "ii" { print $2 }' ;;
        Qqe)  apt-mark showmanual ;;
        Qqet) # manual packages that nothing installed depends on
              apt-mark showmanual \
                  | xargs -r apt-cache rdepends --installed \
                        --no-recommends --no-suggests --no-conflicts \
                        --no-breaks --no-replaces --no-enhances 2>/dev/null \
                  | awk '
                      /^Reverse Depends:/ { next }
                      /^[^ ]/ { if (name != "" && n == 0) print name; name = $1; n = 0; next }
                      /^ /    { n++ }
                      END     { if (name != "" && n == 0) print name }' ;;
        Qqtd) LC_ALL=C apt-get -s autoremove 2>/dev/null | awk '/^Remv/ { print $2 }' ;;
    esac
}

fzfExec() {
    tui_exit
    dependency apt fzf || return

    [[ $1 == "Slq" ]] && argAction="install" || argAction="purge --autoremove"

    packages=$(aptList "$1" | LC_ALL=C sort -u \
        | fzf $fzf_settings --preview 'apt-cache show --no-all-versions {} 2>/dev/null; echo; dpkg -L {} 2>/dev/null')

    if [[ -n "$packages" ]]; then
        packages=$(echo "$packages" | oneLine)
        printExec "$sudoBin apt $argAction $packages"
        $sudoBin apt $argAction $packages
        pressReturn
    fi

    tui_restore
}

uninstallOrphans() {
    tui_exit
    dependency apt || return

    orphans=$($wrapper -Qqtd | oneLine)
    if [[ -n "$orphans" ]]; then
        printExec "$wrapper_sudo -Rsn $orphans"
        printImportant "$MNG_WARN"; echo
        $wrapper_sudo -Rsn $orphans
    else
        printDone "$MNG_DONE"
    fi

    pressReturn
    tui_restore
}

downgrade() {
    tui_exit
    dependency apt fzf || return

    # 1. Pick an installed package
    pkg=$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>/dev/null \
        | awk '$1 == "ii" { print $2 }' | LC_ALL=C sort -u \
        | fzf $fzf_settings --preview "apt-cache policy {}")

    if [[ -n "$pkg" ]]; then
        # 2. Pick a version the repos still carry (madison: " pkg | version | source")
        version=$(apt-cache madison "$pkg" 2>/dev/null \
            | awk -F'|' '{ gsub(/ /, "", $2); print $2 "\t" $3 }' \
            | fzf $fzf_settings --header "Select version for $pkg" \
            | cut -f1)

        if [[ -n "$version" ]]; then
            printExec "$sudoBin apt install --allow-downgrades $pkg=$version"
            $sudoBin apt install --allow-downgrades "$pkg=$version"
        fi

        pressReturn
    fi

    tui_restore
}

cleanCache() {
    tui_exit
    dependency apt || return

    cache_dir="/var/cache/apt/archives"

    # Map the old pacman flag to an apt verb: Sc -> autoclean, Scc -> clean
    case "$1" in
        Scc|clean) action="clean" ;;
        *)         action="autoclean" ;;
    esac

    # Show what's currently cached
    if [ -d "$cache_dir" ]; then
        size=$(du -sh "$cache_dir" 2>/dev/null | cut -f1)
        printImportant "$MNG_CACHE_DIR" "$cache_dir ($size)"
        echo
    fi

    printExec "$sudoBin apt $action"
    $sudoBin apt $action
    pressReturn
    tui_restore
}

recentlyInstalled() {
    tui_exit

    echo "$MNG_RECENT_SCAN"

    if ! ls /var/log/dpkg.log* >/dev/null 2>&1; then
        printError "dpkg log file not found."
        pressReturn
        tui_restore
        return
    fi

    # Sets of installed / manual / autoremovable packages (arch suffix stripped)
    declare -A is_installed is_explicit is_orphan
    local p
    while read -r p; do
        is_installed["$p"]=1
    done < <(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null | awk '$1 == "ii" { print $2 }')

    while read -r p; do
        is_explicit["${p%%:*}"]=1
    done < <(apt-mark showmanual 2>/dev/null)

    # Simulated autoremove = installed automatically and no longer needed
    while read -r p; do
        is_orphan["${p%%:*}"]=1
    done < <(LC_ALL=C apt-get -s autoremove 2>/dev/null | awk '/^Remv/ { print $2 }')

    # dpkg.log lines: "2026-10-21 22:51:03 install pkg:amd64 <none> 1.2-3"
    # Rotated logs (.1, .2.gz, ...) are included; keep the newest date per package.
    declare -A pkg_date
    local line pkg date
    while IFS= read -r line; do
        [[ $line =~ ^([0-9-]+)\ ([0-9:]+)\ install\ ([^\ ]+)\  ]] || continue
        pkg="${BASH_REMATCH[3]%%:*}"
        date="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
        [[ -z "${pkg_date[$pkg]}" || "$date" > "${pkg_date[$pkg]}" ]] && pkg_date["$pkg"]="$date"
    done < <(zcat -f /var/log/dpkg.log* 2>/dev/null)

    local output="" status status_color
    for pkg in "${!pkg_date[@]}"; do
        [[ -n "${is_installed[$pkg]}" ]] || continue

        if [[ -n "${is_orphan[$pkg]}" ]]; then
            status="$MNG_RECENT_ORPHAN"; status_color="31"
        elif [[ -n "${is_explicit[$pkg]}" ]]; then
            status="$MNG_RECENT_EXPLICIT"; status_color="32"
        else
            status="$MNG_RECENT_DEPEND"; status_color="33"
        fi

        output+="${pkg_date[$pkg]}|${pkg}|${status}|${status_color}\n"
    done

    printf '\e[H\e[2J\e[3J'
    {
        printf "%s\t%s\t%s\n" "$(colorize gray bold DATE)" "$(colorize gray bold PACKAGE)" "$(colorize gray bold TYPE)"
        echo -e "$output" | sort -t'|' -k1 | tail -100 | while IFS='|' read -r date pkg status color; do
            [[ -z "$pkg" ]] && continue
            printf "\e[90m%s\e[0m\t%s\t\e[%sm%s\e[0m\n" "$date" "$pkg" "$color" "$status"
        done
    } | column -t -s$'\t'

    pressReturn
    tui_restore
}

flatpakInstalled() {
    tui_exit
    dependency flatpak fzf || return

    local apps=$(
    flatpak list --app --columns=application,name \
    | sort -t$'\t' -k2,2f -k1,1 \
    | fzf $fzf_settings -d$'\t' --with-nth=2 --preview 'flatpak info {1}'
    )

    if [[ -n "$apps" ]]; then
        local ids=$(echo "$apps" | cut -f1 | oneLine)
        printExec "flatpak uninstall $ids"
        flatpak uninstall $ids

        if [ "$flatpakRemoveUnused" = true ]; then
            echo
            printExec "flatpak uninstall --unused $flatpakFlags"
            flatpak uninstall --unused $flatpakFlags
        fi

        pressReturn
    fi

    tui_restore
}

flatpakFlathub() {
    tui_exit
    dependency flatpak fzf curl jq || return

    local apps=$(curl -s https://flathub.org/api/v2/appstream | jq -r '.[]' | fzf $fzf_settings --preview "flatpak remote-info flathub {}")

    if [[ -n "$apps" ]]; then
        apps=$(echo "$apps" | oneLine)
        printExec "flatpak install $apps"
        flatpak install $apps
        pressReturn
    fi

    tui_restore
}





pressReturn() {
    printf '\e[?25l'
    echo -e "\n$(colorize blue bold $ICO_RETURN $MNG_RETURN)"
    IFS= read -rs
}

tui_exit() {
    reset_terminal
    clear_screen
}

tui_restore() {
    clear_screen
    setup_terminal
    showMenu $menu_type
}

dependency() {
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null; then
            printError "${CMD_ERR} ${cmd}"
            pressReturn
            tui_restore
            return 1
        fi
    done
}

get_term_size() {
    read -r LINES COLUMNS < <(stty size)
}

setup_terminal() {
    printf '\e[?1049h\e[?7l\e[?25l\e[2J\e[H'
    stty -echo
}

reset_terminal() {
    printf '\e[?7h\e[?25h\e[2J\e[;r\e[?1049l'
    stty echo
}

clear_screen() {
    printf '\e[H\e[2J'
}

main() {
    ((BASH_VERSINFO[0] > 3)) && read_flags=(-t 0.05)

    trap '' SIGINT
    trap 'reset_terminal' EXIT
    trap 'get_term_size; clear_screen; draw_menu' WINCH

    get_term_size
    setup_terminal
    showMenu main
}

main



# \e[?1049h     Alternative screen buffer
# \e[?1049l     Restore main screen buffer
# \e[?7l        Disable line wrapping
# \e[?7h        Enable line wrapping
# \e[?25l       Hide cursor
# \e[?25h       Show cursor
# \e[2J         Clear terminal
# \e[H          Move cursor to top-left
# \e[;r         Set the scroll region to its default value
# stty -echo    Hide user input
# stty echo     Show user input
